# FirstRing local configuration. Copy to .env without overwriting existing work.
# .env and .env.* are Git-ignored; this example is the intentional exception.
# Full value sources and console steps: docs/environment-setup.md
# Real phone tests: DEPENDENT ON SETUP. Do not paste secrets in chat.

# Public HTTPS origin printed by your tunnel/deployment, with no path/query.
# Twilio must reach this same origin. Replace YOUR_HOST before live mode.
PUBLIC_BASE_URL=https://YOUR_HOST
# Local service choices; these defaults need no provider account.
PORT=8080
DATABASE_URL=sqlite:firstring.db
# Generate locally (password manager or Python secrets.token_urlsafe(32)).
# At least 24 characters. This is FirstRing's operator login, not a provider key.
DEMO_ADMIN_TOKEN=
# Keep replay during setup. It cannot dial or run conversation inference.
DEMO_EXECUTION_MODE=replay
# Only the already-authorized single Sarah/Phone B smoke attempt may be enabled.
TEST_CALLS_AUTHORIZED=false
# No additional handoff or family calls are currently authorized. Keep false.
HANDOFF_CALLS_ENABLED=false
FAMILY_CALLS_ENABLED=false

# Twilio Console account dashboard -> live Account SID and Auth Token.
# SID begins AC. Use the same funded/enabled account as the SIP Domain.
# Auth Token validates webhooks; do not substitute an API Key Secret/test token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional local setup records; generated once for Photon inbound authentication.
# Distinct from the Photon outbound credentials below; the Rust app does not read these.
TWILIO_SIP_DOMAIN=
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Photon Beta project -> Voice -> Lines: the voice-enabled test number in E.164.
PHOTON_NUMBER=
# Photon Beta -> Voice -> assigned SIP profile -> Outbound calls.
# Copy its actual SIP connection host/port, not its authentication realm.
# These are cookbook examples, not verified account assignments.
PHOTON_SIP_HOST=sip.photon.codes
PHOTON_SIP_PORT=5061
# Photon-generated OUTBOUND SIP credentials, with digest MD5 (legacy), TLS/SRTP.
# These are different from the Twilio credential-list login used for INBOUND SIP.
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=

# Your designated consenting Phone B's actual number, e.g. +1 then 10 digits.
# This is the only currently authorized outbound test endpoint.
SARAH_TEST_E164=
# Leave blank: family/clinic roles are not enrolled or authorized yet.
FAMILY_TEST_E164=
CLINIC_TEST_E164=

# probe = initial keypad test; relay = primary conversation; gather = fallback.
VOICE_TRANSPORT=probe
# Startup-only allowlist. Flux changes turn-finalization semantics; compare a
# controlled call before selecting it. Revert by restarting with nova-3-general.
RELAY_SPEECH_MODEL=nova-3-general
# Controlled endpointing experiment: 1000 default, 600 optional; restart required.
RELAY_SPEECH_TIMEOUT_MS=1000
# Static closing format experiment; WAV requires verified offline cache derivatives.
CLOSING_AUDIO_FORMAT=mp3
# Only preset Relay/Say output is currently implemented. This is not a clone.
VOICE_OUTPUT=relay_native
# NVIDIA API Catalog -> exact model below -> Get API Key; save key locally.
# Not needed for the initial two-phone transport test.
NVIDIA_API_KEY=
# Optional direct TTS development fixtures only; Twilio-managed Relay does not read this key.
# --dry-run needs no key; explicit --generate uses it. See docs/audio-fixtures.md.
ELEVENLABS_API_KEY=
# Explicit decision-model backend. Hosted values remain the fallback when Brev is selected.
NEMOTRON_BACKEND=nvidia_hosted
# Brev organization -> Account Settings -> API Keys, provisioning only (not inference auth).
BREV_API_KEY=
# Dedicated vLLM bearer key and private SSH-forwarded endpoint; never reuse NVIDIA_API_KEY.
# Set backend=brev_hosted only after GPU loading and native tool-cycle verification.
BREV_NEMOTRON_API_KEY=
BREV_NEMOTRON_CHAT_URL=http://127.0.0.1:18080/v1/chat/completions
BREV_NEMOTRON_MODEL=
# Preserved NVIDIA-hosted fallback:
NEMOTRON_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Local duration limit, seconds (accepted range 15..600).
MAX_CALL_SECONDS=180

# Reserved optional integrations, currently unimplemented: leave all blank.
# A future approved Zeroshot deployment supplies its HTTPS URL; preset TTS is not it.
MAGPIE_ZERO_SHOT_URL=
# Future Photon messaging uses a project API key/project ID and webhook secret,
# separate from SIP credentials. No text channel is currently configured.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_WEBHOOK_SECRET=

# Distinct owned Photon source line for bounded automated fixtures; never the destination.
AUTOMATED_CALLER_FROM_E164=

# Durable reported-number history: choose demo for staged households; never reuse demo as production.
# Generate a stable random >=32-byte local secret; rotation requires an explicit migration.
REPUTATION_HMAC_KEY=
REPUTATION_SCOPE=demo
# Current serving deployment identity and UTC availability deadline; not historical proof.
NEMOTRON_DEPLOYMENT_ID=
NEMOTRON_AVAILABLE_UNTIL=
